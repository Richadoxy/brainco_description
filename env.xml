<?xml version="1.0" encoding="utf-8"?>
<mujoco model="inverted_pendulum">
    <compiler angle="radian" autolimits="true" />
    <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" density="1.225" viscosity="1.8e-5" />
    <!-- <option timestep="0.001" gravity="0 0 0" integrator="implicitfast" density="1.225" viscosity="1.8e-5" /> -->
    <visual>
        <global realtime="1" />
        <quality shadowsize="16384" numslices="28" offsamples="4" />
        <headlight diffuse="0.5 0.5 0.5" specular="0.2 0.2 0.2" active="1" />
    </visual>

    <asset>
        <mesh name="tetrahedron" vertex="0 0 0 1 0 0 0 1 0 0 0 1" />
        <texture type="skybox" file="desert.png"
            gridsize="3 4" gridlayout=".U..LFRB.D.." />
        <texture name="plane" type="2d" builtin="checker"  rgb1="0.1 0.25 0.1" rgb2="0.2 0.45 0.2"
            width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
        <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true"/>
        <material name="box" rgba="0 0.5 0 1"  emission="0"/>

        <!-- 修改网格纹理为浅蓝色系 -->
        <texture name="grid_texture" type="2d" builtin="checker"
             rgb1="0.6 0.8 1.0" rgb2="0.4 0.6 0.8" width="300" height="300"/>
         <material name="ramp_mat" texture="grid_texture" texrepeat="2 2"/>

        <!-- 新增材质 -->
        <material name="obstacle_red" rgba="0.8 0.2 0.2 1" specular="0.3" shininess="0.3"/>
        <material name="obstacle_blue" rgba="0.2 0.2 0.8 1" specular="0.3" shininess="0.3"/>
        <material name="low_friction" rgba="0.7 0.8 1.0 0.8" specular="0.1" shininess="0.1"/>
        <material name="stair" rgba="0.6 0.4 0.2 1" specular="0.4" shininess="0.5"/>
    </asset>

    <worldbody>
        <!-- 地板仍然使用 ramp_mat，颜色变为浅蓝网格 -->
        <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="ramp_mat" condim="3" />

    </worldbody>
</mujoco>